---
import { formatPrice, formatMileage } from '@/data/vehicles.js';

interface Props {
  vehicle: any;
  showStatus?: boolean;
  compact?: boolean;
}

const { 
  vehicle, 
  showStatus = true, 
  compact = false 
} = Astro.props;

const hasDiscount = vehicle.originalPrice && vehicle.originalPrice > vehicle.price;
const discountPercentage = hasDiscount 
  ? Math.round(((vehicle.originalPrice - vehicle.price) / vehicle.originalPrice) * 100)
  : 0;

const isAvailable = vehicle.status === 'disponible';
---

<article class="vehicle-card-container h-full">
  <div class="card-vehicle group relative h-full flex flex-col">
    <!-- Vehicle Image -->
    <div class="relative overflow-hidden flex-shrink-0">
      <img 
        src={vehicle.images[0]} 
        alt={vehicle.name}
        class="w-full h-48 lg:h-56 object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
      
      <!-- Image Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black-brand/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      
      <!-- Status Badge -->
      {showStatus && (
        <div class="absolute top-4 left-4 z-10">
          {vehicle.featured && (
            <div class="badge badge-featured mb-2 animate-pulse-slow">
              <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              Destacado
            </div>
          )}
          
          {isAvailable && (
            <div class="badge badge-available">
              Disponible
            </div>
          )}
        </div>
      )}
      
      <!-- Discount Badge -->
      {hasDiscount && (
        <div class="absolute top-4 right-4 z-10 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-bold">
          -{discountPercentage}%
        </div>
      )}
      
      <!-- Quick Actions (appear on hover) -->
      <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 z-20">
        <div class="flex space-x-3">
          <a 
            href={`/vehiculos/${vehicle.slug}`}
            class="bg-yellow-ego text-black-brand px-4 py-2 rounded-lg font-semibold hover:bg-yellow-hover transition-colors duration-300 transform hover:scale-105 text-sm"
          >
            Ver Detalles
          </a>
          
          {isAvailable && (
            <button 
              class="bg-surface-dark/90 text-white px-4 py-2 rounded-lg font-semibold hover:bg-surface-dark transition-colors duration-300 transform hover:scale-105 text-sm"
              onclick={`contactVehicle('${vehicle.name}', '${vehicle.slug}')`}
            >
              Contactar
            </button>
          )}
        </div>
      </div>
    </div>
    
    <!-- Vehicle Info - FIXED LAYOUT -->
    <div class="p-4 lg:p-6 flex-grow flex flex-col">
      <!-- Header -->
      <div class="mb-4 flex-shrink-0">
        <div class="flex items-start justify-between mb-2">
          <h3 class="text-lg lg:text-xl font-bold text-white group-hover:text-yellow-ego transition-colors duration-300 flex-grow pr-4 leading-tight">
            <a href={`/vehiculos/${vehicle.slug}`} class="hover:underline">
              {vehicle.name}
            </a>
          </h3>
          
          <div class="text-right flex-shrink-0">
            {hasDiscount && (
              <div class="text-xs text-text-secondary line-through">
                {formatPrice(vehicle.originalPrice!, vehicle.currency)}
              </div>
            )}
            <div class="text-lg lg:text-xl font-bold text-yellow-ego">
              {formatPrice(vehicle.price, vehicle.currency)}
            </div>
          </div>
        </div>
        
        <div class="text-text-secondary text-sm">
          {vehicle.year} • {vehicle.color}
        </div>
      </div>
      
      <!-- Specs Grid -->
      <div class="grid grid-cols-2 gap-3 mb-4 flex-shrink-0">
        <div class="flex items-center space-x-2 text-sm">
          <svg class="w-4 h-4 text-yellow-ego flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <span class="text-text-secondary truncate">{formatMileage(vehicle.mileage)}</span>
        </div>
        
        <div class="flex items-center space-x-2 text-sm">
          <svg class="w-4 h-4 text-yellow-ego flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <span class="text-text-secondary truncate">{vehicle.fuel}</span>
        </div>
        
        <div class="flex items-center space-x-2 text-sm">
          <svg class="w-4 h-4 text-yellow-ego flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"/>
          </svg>
          <span class="text-text-secondary truncate">{vehicle.transmission}</span>
        </div>
        
        <div class="flex items-center space-x-2 text-sm">
          <svg class="w-4 h-4 text-yellow-ego flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
          <span class="text-text-secondary truncate">{vehicle.power}</span>
        </div>
      </div>
      
      <!-- Description -->
      {!compact && (
        <p class="text-text-secondary text-sm mb-4 line-clamp-2 flex-grow">
          {vehicle.description}
        </p>
      )}
      
      <!-- Actions - ALWAYS AT BOTTOM -->
      <div class="flex flex-col space-y-3 mt-auto">
        {isAvailable ? (
          <>
            <a 
              href={`/vehiculos/${vehicle.slug}`}
              class="btn-primary w-full text-center text-sm py-2"
            >
              Ver Detalles Completos
            </a>
            
            <div class="flex space-x-2">
              <button 
                class="btn-secondary flex-1 text-xs py-2"
                onclick={`contactVehicle('${vehicle.name}', '${vehicle.slug}')`}
              >
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                Llamar
              </button>
              
              <button 
                class="btn-ghost flex-1 text-xs py-2"
                onclick={`shareVehicle('${vehicle.name}', '${vehicle.slug}')`}
              >
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"/>
                </svg>
                Compartir
              </button>
            </div>
          </>
        ) : (
          <div class="text-center py-4">
            <span class="text-text-secondary text-sm">
              Este vehículo ya fue vendido
            </span>
          </div>
        )}
      </div>
    </div>
  </div>
</article>

<script>
  // Global functions for vehicle actions
  window.contactVehicle = function(vehicleName, vehicleSlug) {
    const message = `Hola! Me interesa el ${vehicleName} que vi en su sitio web. ¿Podrían darme más información?`;
    const whatsappUrl = `https://wa.me/56912345678?text=${encodeURIComponent(message)}`;
    window.open(whatsappUrl, '_blank');
  };
  
  window.shareVehicle = function(vehicleName, vehicleSlug) {
    const url = `${window.location.origin}/vehiculos/${vehicleSlug}`;
    const title = `${vehicleName} - E-Go Cars`;
    
    if (navigator.share) {
      navigator.share({
        title: title,
        text: `Mira este vehículo en E-Go Cars: ${vehicleName}`,
        url: url
      }).catch(console.error);
    } else {
      navigator.clipboard.writeText(url).then(() => {
        alert('Enlace copiado al portapapeles');
      }).catch(() => {
        prompt('Copia este enlace:', url);
      });
    }
  };
</script>

<style>
  /* FIXED: Container height and layout */
  .vehicle-card-container {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  
  .card-vehicle {
    flex: 1;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }
  
  .card-vehicle:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }
  
  /* Image zoom effect */
  .card-vehicle img {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-vehicle:hover img {
    transform: scale(1.05);
  }
  
  /* Line clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Badge animations */
  .badge {
    animation: fadeInScale 0.5s ease-out;
  }
  
  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  
  /* Button optimizations */
  .btn-primary,
  .btn-secondary,
  .btn-ghost {
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  
  .btn-primary:hover,
  .btn-secondary:hover,
  .btn-ghost:hover {
    transform: translateY(-1px);
  }
  
  /* Mobile responsiveness */
  @media (max-width: 640px) {
    .card-vehicle .p-4 {
      padding: 1rem;
    }
    
    .card-vehicle .grid-cols-2 {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    
    .card-vehicle .text-lg {
      font-size: 1rem;
    }
    
    .card-vehicle .text-xl {
      font-size: 1.125rem;
    }
  }
</style>