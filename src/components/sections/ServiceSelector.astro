---
// Service selector section with three main options
---

<section id="servicios" class="py-16 lg:py-24 bg-surface-dark relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <svg class="w-full h-full" viewBox="0 0 100 100" fill="none">
      <defs>
        <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
          <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100" height="100" fill="url(#grid)" />
    </svg>
  </div>
  
  <div class="container-custom relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-3xl lg:text-5xl font-bold mb-6">
        ¿Qué <span class="text-gradient">necesitas hoy?</span>
      </h2>
      <p class="text-lg lg:text-xl text-text-secondary max-w-3xl mx-auto">
        Selecciona el servicio que buscas y te ayudaremos a encontrar la mejor solución
      </p>
    </div>
    
    <!-- Service Cards -->
    <div class="grid md:grid-cols-3 gap-8 lg:gap-12 mb-16">
      <!-- Comprar -->
      <div class="service-card group cursor-pointer animate-on-scroll" data-service="comprar">
        <div class="card p-8 text-center h-full border-2 border-transparent hover:border-yellow-ego transition-all duration-300 group-hover:scale-105">
          <div class="w-16 h-16 bg-yellow-ego/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-yellow-ego group-hover:scale-110 transition-all duration-300">
            <svg class="w-8 h-8 text-yellow-ego group-hover:text-black-brand transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m-2.4-3h2.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17M17 13v6a2 2 0 01-2 2H9a2 2 0 01-2-2v-6m8 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-yellow-ego transition-colors duration-300">
            Comprar
          </h3>
          <p class="text-text-secondary mb-6 leading-relaxed">
            Encuentra el vehículo perfecto para ti en nuestro amplio catálogo de autos certificados
          </p>
          <div class="text-yellow-ego font-semibold opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            Explorar vehículos →
          </div>
        </div>
      </div>
      
      <!-- Vender -->
      <div class="service-card group cursor-pointer animate-on-scroll" data-service="vender">
        <div class="card p-8 text-center h-full border-2 border-transparent hover:border-yellow-ego transition-all duration-300 group-hover:scale-105">
          <div class="w-16 h-16 bg-yellow-ego/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-yellow-ego group-hover:scale-110 transition-all duration-300">
            <svg class="w-8 h-8 text-yellow-ego group-hover:text-black-brand transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-yellow-ego transition-colors duration-300">
            Vender
          </h3>
          <p class="text-text-secondary mb-6 leading-relaxed">
            Vende tu vehículo al mejor precio con nuestra evaluación profesional y proceso rápido
          </p>
          <div class="text-yellow-ego font-semibold opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            Obtener cotización →
          </div>
        </div>
      </div>
      
      <!-- Asesorías & Servicios -->
      <div class="service-card group cursor-pointer animate-on-scroll" data-service="servicios">
        <div class="card p-8 text-center h-full border-2 border-transparent hover:border-yellow-ego transition-all duration-300 group-hover:scale-105">
          <div class="w-16 h-16 bg-yellow-ego/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-yellow-ego group-hover:scale-110 transition-all duration-300">
            <svg class="w-8 h-8 text-yellow-ego group-hover:text-black-brand transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-yellow-ego transition-colors duration-300">
            Asesorías & Servicios
          </h3>
          <p class="text-text-secondary mb-6 leading-relaxed">
            Mantenimiento y asesoría especializada para mantener tu vehículo en perfectas condiciones
          </p>
          <div class="text-yellow-ego font-semibold opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            Ver servicios →
          </div>
        </div>
      </div>
    </div>
    
    <!-- Contact Form -->
    <div class="max-w-4xl mx-auto animate-on-scroll">
      <div class="card p-8 lg:p-12">
        <h3 class="text-2xl lg:text-3xl font-bold text-center mb-8">
          Completa tus datos y te contactamos
        </h3>
        
        <form id="contact-form" class="space-y-6">
          <!-- Service Type Hidden Input -->
          <input type="hidden" id="service-type" name="service_type" value="">
          
          <div class="grid md:grid-cols-2 gap-6">
            <!-- Name -->
            <div>
              <label for="name" class="form-label">
                Nombre completo *
              </label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                class="form-input"
                placeholder="Tu nombre completo"
              >
            </div>
            
            <!-- Phone -->
            <div>
              <label for="phone" class="form-label">
                Teléfono *
              </label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                required 
                class="form-input"
                placeholder="+56 9 1234 5678"
              >
            </div>
          </div>
          
          <!-- Email -->
          <div>
            <label for="email" class="form-label">
              Email *
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              class="form-input"
              placeholder="tu@email.com"
            >
          </div>
          
          <!-- Message -->
          <div>
            <label for="message" class="form-label">
              Mensaje (opcional)
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              class="form-input resize-none"
              placeholder="Cuéntanos qué necesitas..."
            ></textarea>
          </div>
          
          <!-- Submit Button -->
          <div class="text-center pt-4">
            <button 
              type="submit" 
              class="btn-primary text-lg px-8 py-4 w-full md:w-auto min-w-64"
              id="submit-btn"
            >
              <span class="submit-text">Enviar Solicitud</span>
              <div class="loading-spinner hidden ml-2"></div>
            </button>
          </div>
          
          <!-- Privacy Notice -->
          <p class="text-sm text-text-secondary text-center">
            Al enviar este formulario, aceptas que E-Go Cars se ponga en contacto contigo 
            para brindarte la información solicitada.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const serviceCards = document.querySelectorAll('.service-card');
    const serviceTypeInput = document.getElementById('service-type');
    const contactForm = document.getElementById('contact-form');
    
    // Service card selection
    serviceCards.forEach(card => {
      card.addEventListener('click', () => {
        // Remove active state from all cards
        serviceCards.forEach(c => c.classList.remove('active'));
        
        // Add active state to clicked card
        card.classList.add('active');
        
        // Update hidden input
        const service = card.getAttribute('data-service');
        if (serviceTypeInput && service) {
          serviceTypeInput.value = service;
        }
        
        // Scroll to form
        const form = document.getElementById('contact-form');
        if (form) {
          form.scrollIntoView({ 
            behavior: 'smooth', 
            block: 'nearest' 
          });
        }
      });
    });
    
    // Form submission
    contactForm?.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Simple demo submission
      const submitBtn = document.getElementById('submit-btn');
      const submitText = submitBtn?.querySelector('.submit-text');
      
      if (submitText) {
        submitText.textContent = '¡Enviado!';
        setTimeout(() => {
          submitText.textContent = 'Enviar Solicitud';
          contactForm.reset();
          serviceCards.forEach(c => c.classList.remove('active'));
        }, 2000);
      }
    });
  });
</script>

<style>
  .service-card.active .card {
    border-color: var(--color-yellow-ego);
    transform: scale(1.05);
    box-shadow: 0 10px 30px rgba(255, 210, 10, 0.3);
  }
  
  .service-card.active .text-yellow-ego {
    opacity: 1;
  }
  
  .service-card.active .w-16 {
    background-color: var(--color-yellow-ego);
    transform: scale(1.1);
  }
  
  .service-card.active .w-16 svg {
    color: var(--color-black-brand);
  }
  
  .service-card.active h3 {
    color: var(--color-yellow-ego);
  }
</style>