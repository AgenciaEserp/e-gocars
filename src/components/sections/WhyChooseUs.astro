---
// Why Choose Us section with benefits
---

<section class="py-16 lg:py-24 bg-surface-dark relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-10 right-10 w-64 h-64 border border-yellow-ego rounded-full"></div>
    <div class="absolute bottom-10 left-10 w-32 h-32 border border-yellow-ego rounded-full"></div>
  </div>
  
  <div class="container-custom relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-3xl lg:text-5xl font-bold mb-6">
        ¿Por qué elegir <span class="text-gradient">E-Go Cars?</span>
      </h2>
      <p class="text-lg lg:text-xl text-text-secondary max-w-3xl mx-auto">
        Más de 15 años de experiencia nos respaldan como el concesionario líder en calidad y servicio
      </p>
    </div>
    
    <!-- Benefits Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      <!-- Garantía Extendida -->
      <div class="benefit-card animate-on-scroll">
        <div class="card p-8 text-center h-full hover:border-yellow-ego transition-all duration-300">
          <div class="w-16 h-16 bg-yellow-ego/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-yellow-ego transition-all duration-300">
            <svg class="w-8 h-8 text-yellow-ego" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4 text-white">Garantía Extendida</h3>
          <p class="text-text-secondary leading-relaxed">
            Todos nuestros vehículos incluyen garantía extendida de hasta 3 años para tu tranquilidad total
          </p>
        </div>
      </div>
      
      <!-- Financiamiento 0% -->
      <div class="benefit-card animate-on-scroll">
        <div class="card p-8 text-center h-full border-2 border-yellow-ego hover:shadow-yellow transition-all duration-300">
          <div class="w-16 h-16 bg-yellow-ego rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-black-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4 text-yellow-ego">Financiamiento 0%</h3>
          <p class="text-text-secondary leading-relaxed">
            Planes de financiamiento con tasa 0% de interés y aprobación inmediata en menos de 24 horas
          </p>
        </div>
      </div>
      
      <!-- Servicio Técnico -->
      <div class="benefit-card animate-on-scroll">
        <div class="card p-8 text-center h-full hover:border-yellow-ego transition-all duration-300">
          <div class="w-16 h-16 bg-yellow-ego/10 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-yellow-ego" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4 text-white">Servicio Técnico</h3>
          <p class="text-text-secondary leading-relaxed">
            Taller especializado con técnicos certificados y repuestos originales para todas las marcas
          </p>
        </div>
      </div>
      
      <!-- Vehículos Certificados -->
      <div class="benefit-card animate-on-scroll">
        <div class="card p-8 text-center h-full hover:border-yellow-ego transition-all duration-300">
          <div class="w-16 h-16 bg-yellow-ego/10 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-yellow-ego" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4 text-white">Vehículos Certificados</h3>
          <p class="text-text-secondary leading-relaxed">
            Rigurosa inspección de 150 puntos garantiza la calidad y confiabilidad de cada vehículo
          </p>
        </div>
      </div>
      
      <!-- Atención Personalizada -->
      <div class="benefit-card animate-on-scroll">
        <div class="card p-8 text-center h-full hover:border-yellow-ego transition-all duration-300">
          <div class="w-16 h-16 bg-yellow-ego/10 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-yellow-ego" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4 text-white">Atención Personalizada</h3>
          <p class="text-text-secondary leading-relaxed">
            Equipo de asesores expertos te acompañan durante todo el proceso de compra y post-venta
          </p>
        </div>
      </div>
      
      <!-- Valor de Intercambio -->
      <div class="benefit-card animate-on-scroll">
        <div class="card p-8 text-center h-full hover:border-yellow-ego transition-all duration-300">
          <div class="w-16 h-16 bg-yellow-ego/10 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-yellow-ego" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4 text-white">Mejor Valor de Intercambio</h3>
          <p class="text-text-secondary leading-relaxed">
            Evaluación justa de tu vehículo actual con el mejor precio del mercado como parte de pago
          </p>
        </div>
      </div>
    </div>
    
    <!-- Stats Section -->
    <div class="bg-black-brand rounded-2xl p-8 lg:p-12 animate-on-scroll">
      <div class="text-center mb-12">
        <h3 class="text-2xl lg:text-3xl font-bold mb-4">
          Nuestra <span class="text-gradient">Experiencia</span> en Números
        </h3>
        <p class="text-text-secondary">
          Más de 15 años construyendo confianza con nuestros clientes
        </p>
      </div>
      
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-yellow-ego mb-2">15+</div>
          <div class="text-text-secondary">Años de Experiencia</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-yellow-ego mb-2">2,500+</div>
          <div class="text-text-secondary">Clientes Satisfechos</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-yellow-ego mb-2">98%</div>
          <div class="text-text-secondary">Nivel de Satisfacción</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-yellow-ego mb-2">24/7</div>
          <div class="text-text-secondary">Soporte al Cliente</div>
        </div>
      </div>
    </div>
    
    <!-- CTA Section -->
    <div class="text-center mt-16 animate-on-scroll">
      <h3 class="text-2xl lg:text-3xl font-bold mb-6">
        ¿Listo para encontrar tu próximo vehículo?
      </h3>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/catalogo" class="btn-primary text-lg px-8 py-4">
          Explorar Vehículos
        </a>
        <a href="/contacto" class="btn-secondary text-lg px-8 py-4">
          Hablar con un Asesor
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .benefit-card:hover .card {
    transform: translateY(-4px);
  }
  
  .benefit-card:hover .w-16 {
    transform: scale(1.1);
  }
  
  /* Animation for stats */
  @keyframes countUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-on-scroll.animate-in .text-4xl,
  .animate-on-scroll.animate-in .text-5xl {
    animation: countUp 0.8s ease-out;
  }
</style>