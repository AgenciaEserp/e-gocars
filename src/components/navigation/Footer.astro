---
// Footer component with complete site links
---

<footer class="bg-surface-dark border-t border-border-gray">
  <div class="container-custom py-16">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <!-- Brand Section -->
      <div class="lg:col-span-2">
        <div class="flex items-center space-x-3 mb-6">
          <div class="w-12 h-12 bg-yellow-ego rounded-lg flex items-center justify-center">
            <svg class="w-7 h-7 text-black-brand" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
            </svg>
          </div>
          <div>
            <div class="text-2xl font-bold">
              <span class="text-gradient">E-Go</span>
              <span class="text-white">Cars</span>
            </div>
          </div>
        </div>
        
        <p class="text-text-secondary mb-6 max-w-md">
          Tu concesionario de confianza con más de 15 años de experiencia en la venta de vehículos premium y servicios automotrices especializados.
        </p>
        
        <!-- Social Media -->
        <div class="flex space-x-4">
          <a href="#" class="w-10 h-10 bg-border-gray rounded-lg flex items-center justify-center text-text-secondary hover:bg-yellow-ego hover:text-black-brand transition-all duration-300">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 bg-border-gray rounded-lg flex items-center justify-center text-text-secondary hover:bg-yellow-ego hover:text-black-brand transition-all duration-300">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 bg-border-gray rounded-lg flex items-center justify-center text-text-secondary hover:bg-yellow-ego hover:text-black-brand transition-all duration-300">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001.012.001z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 bg-border-gray rounded-lg flex items-center justify-center text-text-secondary hover:bg-yellow-ego hover:text-black-brand transition-all duration-300">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.025 0C5.38 0 .025 5.355.025 11.988c0 2.096.547 4.142 1.588 5.945L.025 24l6.181-1.592c1.746.957 3.728 1.462 5.819 1.462 6.644 0 12.025-5.355 12.025-11.988S18.669-.012 12.025-.012z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Enlaces Rápidos -->
      <div>
        <h3 class="text-lg font-semibold text-white mb-6">Enlaces Rápidos</h3>
        <ul class="space-y-3">
          <li><a href="/" class="link-hover">Inicio</a></li>
          <li><a href="/nosotros" class="link-hover">Nosotros</a></li>
          <li><a href="/catalogo" class="link-hover">Catálogo</a></li>
          <li><a href="/servicios" class="link-hover">Servicios</a></li>
          <li><a href="/contacto" class="link-hover">Contacto</a></li>
        </ul>
      </div>
      
      <!-- Servicios -->
      <div>
        <h3 class="text-lg font-semibold text-white mb-6">Servicios</h3>
        <ul class="space-y-3">
          <li><a href="#" class="link-hover">Venta de Vehículos</a></li>
          <li><a href="#" class="link-hover">Financiamiento</a></li>
          <li><a href="#" class="link-hover">Seguros</a></li>
          <li><a href="#" class="link-hover">Mantenimiento</a></li>
          <li><a href="#" class="link-hover">Asesoría Especializada</a></li>
        </ul>
      </div>
      
      <!-- Contacto -->
      <div>
        <h3 class="text-lg font-semibold text-white mb-6">Contacto</h3>
        <div class="space-y-4">
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-yellow-ego mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <p class="text-text-secondary text-sm">Av. Principal 123</p>
              <p class="text-text-secondary text-sm">Santiago, Chile</p>
            </div>
          </div>
          
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-yellow-ego flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:+56912345678" class="text-text-secondary text-sm hover:text-yellow-ego transition-colors">
              +56 9 1234 5678
            </a>
          </div>
          
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-yellow-ego flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:contacto@ego-cars.cl" class="text-text-secondary text-sm hover:text-yellow-ego transition-colors">
              contacto@ego-cars.cl
            </a>
          </div>
          
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-yellow-ego flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div class="text-text-secondary text-sm">
              <p>Lun - Vie: 9:00 - 19:00</p>
              <p>Sáb: 9:00 - 17:00</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Bottom Footer -->
    <div class="pt-8 border-t border-border-gray">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <p class="text-text-secondary text-sm">
          © 2024 E-Go Cars. Todos los derechos reservados.
        </p>
        
        <div class="flex space-x-6 text-sm">
          <a href="/terminos" class="text-text-secondary hover:text-yellow-ego transition-colors">
            Términos y Condiciones
          </a>
          <a href="/privacidad" class="text-text-secondary hover:text-yellow-ego transition-colors">
            Política de Privacidad
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .link-hover {
    @apply text-text-secondary hover:text-yellow-ego transition-colors duration-300 relative;
  }
  
  .link-hover::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-yellow-ego);
    transition: width 0.3s ease-in-out;
  }
  
  .link-hover:hover::after {
    width: 100%;
  }
</style>